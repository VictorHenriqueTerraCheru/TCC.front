// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MarcadorProblema > ativa / alta 1`] = `"<div class="marcador-problema" data-status="ativa" data-faixa="alta" style="position:relative;width:38px;height:45px;transform-origin:50% 100%"><span class="pulso-alerta" aria-hidden="true" style="position:absolute;left:0;top:0;width:38px;height:38px;background:var(--cat-eletrica)"></span><span aria-hidden="true" style="position:absolute;left:50%;top:36px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #ffffff;opacity:1"></span><span aria-hidden="true" style="position:absolute;left:0;top:0;width:38px;height:38px;box-sizing:border-box;border-radius:50%;background:var(--cat-eletrica);border:2.5px solid #ffffff;border-style:solid;box-shadow:0 4px 10px rgba(0,0,0,.28);opacity:1;display:grid;place-items:center"><span class="material-symbols-rounded" style="font-size:21px;line-height:1;color:#ffffff;font-variation-settings:&#x27;FILL&#x27; 1">bolt</span></span></div>"`;

exports[`MarcadorProblema > ativa / baixa 1`] = `"<div class="marcador-problema" data-status="ativa" data-faixa="baixa" style="position:relative;width:25px;height:32px;transform-origin:50% 100%"><span aria-hidden="true" style="position:absolute;left:50%;top:23px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #ffffff;opacity:0.55"></span><span aria-hidden="true" style="position:absolute;left:0;top:0;width:25px;height:25px;box-sizing:border-box;border-radius:50%;background:var(--cat-eletrica);border:2.5px solid #ffffff;border-style:solid;box-shadow:0 4px 10px rgba(0,0,0,.28);opacity:0.55;display:grid;place-items:center"><span class="material-symbols-rounded" style="font-size:14px;line-height:1;color:#ffffff;font-variation-settings:&#x27;FILL&#x27; 1">bolt</span></span></div>"`;

exports[`MarcadorProblema > ativa / media 1`] = `"<div class="marcador-problema" data-status="ativa" data-faixa="media" style="position:relative;width:31px;height:38px;transform-origin:50% 100%"><span aria-hidden="true" style="position:absolute;left:50%;top:29px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #ffffff;opacity:1"></span><span aria-hidden="true" style="position:absolute;left:0;top:0;width:31px;height:31px;box-sizing:border-box;border-radius:50%;background:var(--cat-eletrica);border:2.5px solid #ffffff;border-style:solid;box-shadow:0 4px 10px rgba(0,0,0,.28);opacity:1;display:grid;place-items:center"><span class="material-symbols-rounded" style="font-size:17px;line-height:1;color:#ffffff;font-variation-settings:&#x27;FILL&#x27; 1">bolt</span></span></div>"`;

exports[`MarcadorProblema > nova / null 1`] = `"<div class="marcador-problema" data-status="nova" data-faixa="nenhuma" style="position:relative;width:28px;height:35px;transform-origin:50% 100%"><span aria-hidden="true" style="position:absolute;left:50%;top:26px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #ffffff;opacity:0.9"></span><span aria-hidden="true" style="position:absolute;left:0;top:0;width:28px;height:28px;box-sizing:border-box;border-radius:50%;background:var(--cat-eletrica);border:2.5px solid #ffffff;border-style:solid;box-shadow:0 4px 10px rgba(0,0,0,.28);opacity:0.9;display:grid;place-items:center"><span class="material-symbols-rounded" style="font-size:16px;line-height:1;color:#ffffff;font-variation-settings:&#x27;FILL&#x27; 1">bolt</span></span><span style="position:absolute;top:-8px;left:16.8px;padding:1px 5px;border-radius:6px;background:var(--primario-cheio);color:#ffffff;border:1.5px solid #ffffff;font-size:10px;font-weight:700;line-height:14px;white-space:nowrap">Nova</span></div>"`;

exports[`MarcadorProblema > possivelmenteResolvida / media 1`] = `"<div class="marcador-problema" data-status="possivelmenteResolvida" data-faixa="media" style="position:relative;width:31px;height:38px;transform-origin:50% 100%"><span aria-hidden="true" style="position:absolute;left:50%;top:29px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #ffffff;opacity:1"></span><span aria-hidden="true" style="position:absolute;left:0;top:0;width:31px;height:31px;box-sizing:border-box;border-radius:50%;background:var(--cat-eletrica);border:2.5px solid #ffffff;border-style:dashed;box-shadow:0 4px 10px rgba(0,0,0,.28);opacity:1;display:grid;place-items:center"><span class="material-symbols-rounded" style="font-size:17px;line-height:1;color:#ffffff;font-variation-settings:&#x27;FILL&#x27; 1">bolt</span></span><span class="material-symbols-rounded" aria-hidden="true" style="position:absolute;top:-4px;right:-6px;width:16px;height:16px;border-radius:999px;background:var(--primario-cheio);color:#ffffff;border:1.5px solid #fff;font-size:12px;line-height:13px;text-align:center">check</span></div>"`;
